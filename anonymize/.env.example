# Khoa ma hoa cho anonymize.py
# Tao khoa that bang:  python anonymize.py genkey
# KHONG commit file .env that len git.

# Cach 1 (khuyen dung): 64 byte ngau nhien, ma hoa base64
ANONYMIZE_KEY=REPLACE_ME_CHAY_LENH_GENKEY

# Cach 2: dan xuat tu passphrase bang scrypt (chi dung khi khong tien luu key nhi phan)
# ANONYMIZE_PASSPHRASE=mot-cau-mat-khau-that-dai-va-ngau-nhien
# ANONYMIZE_SALT=chuoi-salt-co-dinh-cho-du-an-nay
